data(meuse)
meuse[1:5,]
meuse_sf <- st_as_sf(meuse, coords = c("x","y"), crs = 28922)
plot(meuse_sf[,"zinc"], pch=20, axes=TRUE)
formula <- log(zinc) ~ soil + ffreq + dist
cvario <- variogram(formula, data=meuse_sf, cloud=TRUE)
plot(cvario)
vario <- variogram(formula, data=meuse_sf)
plot(vario)
vario <- variogram(formula, data=meuse_sf, cut=1300, width=50)
plot(vario)
varioSph <- fit.variogram(vario, vgm(psill = 0.15, "Sph", range = 700))
varioSph <- fit.variogram(vario, vgm(psill = 0.15, "Sph", range = 700, nuggef=0.05))
varioExp <- fit.variogram(vario, vgm(psill = 0.15, "Exp", range = 700, nugget=0.05))
varioGau <- fit.variogram(vario, vgm(psill = 0.15), "Gau", range=700
plot(vario, varioSph)
varioGau <- fit.variogram(vario, vgm(psill = 0.15), "Gau", range=700
varioGau <- fit.variogram(vario, vgm(psill = 0.15), "Gau", range=700
varioGau <- fit.variogram(vario, vgm(psill = 0.15), "Gau", range=700))
varioGau <- fit.variogram(vario, vgm(psill = 0.15, "Gau", range=700))
plot(vario, varioSph)
plot(vario, varioExp)
plot(vario,varioGau)
varioSph
varioExp
varioGau
